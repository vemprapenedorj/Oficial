# Compress HTML, CSS, JS, XML and SVG
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# Caching for Static Assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Images
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"

  # Fonts
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  # CSS / JS
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_setenvif.c>
  SetEnvIfNoCase Host "^(homologacao\.)?vemprapenedo\.com(?::[0-9]+)?$" IS_TEST_ENV
  SetEnvIfNoCase Host "^homologacao\.vemprapenedo\.com\.br(?::[0-9]+)?$" IS_TEST_ENV
</IfModule>

<IfModule mod_headers.c>
  # Os ambientes de homologação nunca devem ser indexados ou arquivados.
  Header always set X-Robots-Tag "noindex, nofollow, noarchive" env=IS_TEST_ENV

  # Set strict cache policies for versioned build assets
  <FilesMatch "\.(css|js|woff2?)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  <FilesMatch "\.(png|jpe?g|webp|avif|gif|ico|svg)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Prevent caching of index.html, sitemap.xml and JSON to allow updates
  <FilesMatch "\.(html|xml|json)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
# Serve um robots.txt restritivo nos ambientes de homologação.
RewriteEngine On
RewriteCond %{HTTP_HOST} ^(homologacao\.)?vemprapenedo\.com$ [NC,OR]
RewriteCond %{HTTP_HOST} ^homologacao\.vemprapenedo\.com\.br$ [NC]
RewriteRule ^robots\.txt$ /robots-staging.txt [END]

# URLs públicas sem barra que possuem uma página SSG são normalizadas em um
# único salto, consolidando ao mesmo tempo HTTPS, domínio sem www e barra final.
RewriteCond %{HTTP_HOST} ^(?:www\.)?vemprapenedo\.com\.br$ [NC]
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ https://vemprapenedo.com.br/$1/ [R=301,END,NE]

# Consolida HTTPS e domínio nas demais URLs públicas (raiz, arquivos e URLs que
# já possuem barra final).
RewriteCond %{HTTP_HOST} ^(?:www\.)?vemprapenedo\.com\.br$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.vemprapenedo\.com\.br$ [NC]
RewriteRule ^ https://vemprapenedo.com.br%{REQUEST_URI} [R=301,END,NE]

# A homologação preserva o próprio host e também consolida HTTPS + barra final
# em um único redirecionamento para páginas SSG.
RewriteCond %{HTTP_HOST} ^(?:homologacao\.)?vemprapenedo\.com$ [NC,OR]
RewriteCond %{HTTP_HOST} ^homologacao\.vemprapenedo\.com\.br$ [NC]
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ https://%{HTTP_HOST}/$1/ [R=301,END,NE]

RewriteCond %{HTTP_HOST} ^(?:homologacao\.)?vemprapenedo\.com$ [NC,OR]
RewriteCond %{HTTP_HOST} ^homologacao\.vemprapenedo\.com\.br$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,END,NE]

# Redirects canônicos de rotas antigas. Todos os destinos já são as URLs finais.
RewriteRule ^contatos/?$ /contato/ [R=301,END,NC,NE]
RewriteCond %{DOCUMENT_ROOT}/blog/artigo/$1/index.html -f
RewriteRule ^blog/(?!artigo/)([^/]+)/?$ /blog/artigo/$1/ [R=301,END,NC,NE]
RewriteCond %{DOCUMENT_ROOT}/gastronomia/$1/index.html -f
RewriteRule ^restaurantes/([^/]+)/?$ /gastronomia/$1/ [R=301,END,NC,NE]
RewriteCond %{DOCUMENT_ROOT}/onde-ficar/$1/index.html -f
RewriteRule ^pousadas/([^/]+)/?$ /onde-ficar/$1/ [R=301,END,NC,NE]
RewriteCond %{DOCUMENT_ROOT}/onde-ficar/$1/index.html -f
RewriteRule ^hoteis/([^/]+)/?$ /onde-ficar/$1/ [R=301,END,NC,NE]

# /detalhe/:slug precisa de regras explícitas porque a categoria canônica
# depende do estabelecimento cadastrado.
RewriteRule ^detalhe/expedicao-raizes/?$ /o-que-fazer/expedicao-raizes/ [R=301,END,NC,NE]
RewriteRule ^detalhe/rodrigo-dione/?$ /o-que-fazer/rodrigo-dione/ [R=301,END,NC,NE]
RewriteRule ^detalhe/pousada-aurora-da-mantiqueira/?$ /onde-ficar/pousada-aurora-da-mantiqueira/ [R=301,END,NC,NE]
RewriteRule ^detalhe/pousada-villa-luna/?$ /onde-ficar/pousada-villa-luna/ [R=301,END,NC,NE]
RewriteRule ^detalhe/pousada-rainha-da-mata/?$ /onde-ficar/pousada-rainha-da-mata/ [R=301,END,NC,NE]
RewriteRule ^detalhe/pousada-finlandia/?$ /onde-ficar/pousada-finlandia/ [R=301,END,NC,NE]
RewriteRule ^detalhe/casa-da-picanha/?$ /gastronomia/casa-da-picanha/ [R=301,END,NC,NE]
RewriteRule ^detalhe/pizza-da-villa/?$ /gastronomia/pizza-da-villa/ [R=301,END,NC,NE]

# Arquivos e diretórios físicos (incluindo as páginas SSG) são servidos
# diretamente. Não há fallback SPA em produção: rota desconhecida é 404 real.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [END]

ErrorDocument 404 /404.html
RewriteRule ^ - [R=404,END]
